{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfbloombergdata"
		},
		"LS_AZSQL_BLOOMBERG_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZSQL_BLOOMBERG'"
		},
		"LS_ADLS_BRAZIL_SOURCE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_SOURCE'"
		},
		"LS_ADLS_BRAZIL_LANDING_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_LANDING'"
		},
		"LS_ADLS_BRAZIL_CURATED_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_CURATED'"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "vbdbbloombergserver.database.windows.net"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vbdbbloomberg"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vbadmin"
		},
		"vbbloombergSHIR_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/ebf9de76-97ab-4029-b09a-0e5b73edc314/resourceGroups/rg-vb-az-ecommerce-dev/providers/Microsoft.DataFactory/factories/adfvbecommercedev/integrationruntimes/SHIR-ECOMMERCE-ONPREM"
		},
		"LS_ADLS_BRAZIL_SOURCE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloombergdata.dfs.core.windows.net"
		},
		"LS_ADLS_BRAZIL_LANDING_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloomberglanding.dfs.core.windows.net/"
		},
		"LS_ADLS_BRAZIL_CURATED_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloombergcurated.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfbloombergdata_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AZSQL_BLOOMBERG_password": {
						"value": "[parameters('LS_AZSQL_BLOOMBERG_password')]"
					},
					"LS_ADLS_BRAZIL_SOURCE_accountKey": {
						"value": "[parameters('LS_ADLS_BRAZIL_SOURCE_accountKey')]"
					},
					"LS_ADLS_BRAZIL_LANDING_accountKey": {
						"value": "[parameters('LS_ADLS_BRAZIL_LANDING_accountKey')]"
					},
					"LS_ADLS_BRAZIL_CURATED_accountKey": {
						"value": "[parameters('LS_ADLS_BRAZIL_CURATED_accountKey')]"
					},
					"LS_AZSQL_BLOOMBERG_properties_typeProperties_server": {
						"value": "[parameters('LS_AZSQL_BLOOMBERG_properties_typeProperties_server')]"
					},
					"LS_AZSQL_BLOOMBERG_properties_typeProperties_database": {
						"value": "[parameters('LS_AZSQL_BLOOMBERG_properties_typeProperties_database')]"
					},
					"LS_AZSQL_BLOOMBERG_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZSQL_BLOOMBERG_properties_typeProperties_userName')]"
					},
					"vbbloombergSHIR_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('vbbloombergSHIR_properties_typeProperties_linkedInfo_resourceId')]"
					},
					"LS_ADLS_BRAZIL_SOURCE_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_BRAZIL_SOURCE_properties_typeProperties_url')]"
					},
					"LS_ADLS_BRAZIL_LANDING_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_BRAZIL_LANDING_properties_typeProperties_url')]"
					},
					"LS_ADLS_BRAZIL_CURATED_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_BRAZIL_CURATED_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}