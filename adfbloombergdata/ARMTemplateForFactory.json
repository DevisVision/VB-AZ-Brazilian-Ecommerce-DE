{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfbloombergdata"
		},
		"LS_ADLS_BRAZIL_CURATED_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_CURATED'"
		},
		"LS_ADLS_BRAZIL_LANDING_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_LANDING'"
		},
		"LS_ADLS_BRAZIL_SOURCE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_SOURCE'"
		},
		"LS_AZSQL_BLOOMBERG_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZSQL_BLOOMBERG'"
		},
		"LS_ADLS_BRAZIL_CURATED_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloombergcurated.dfs.core.windows.net/"
		},
		"LS_ADLS_BRAZIL_LANDING_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloomberglanding.dfs.core.windows.net/"
		},
		"LS_ADLS_BRAZIL_SOURCE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloombergdata.dfs.core.windows.net"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "vbdbbloombergserver.database.windows.net"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vbdbbloomberg"
		},
		"LS_AZSQL_BLOOMBERG_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vbadmin"
		},
		"vbbloombergSHIR_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/ebf9de76-97ab-4029-b09a-0e5b73edc314/resourceGroups/rg-vb-az-ecommerce-dev/providers/Microsoft.DataFactory/factories/adfvbecommercedev/integrationruntimes/SHIR-ECOMMERCE-ONPREM"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_INGEST_CSV')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKUP_CSV_JOB_METADATA",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n    'EXEC dbo.vb_get_job_dtls @job_id = ',\n    string(pipeline().parameters.p_job_id)\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AZSQL_BLOOMBERG",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "GET_METADATA_SOURCE_FILES",
						"type": "GetMetadata",
						"dependsOn": [
							{
								"activity": "LKUP_CSV_JOB_METADATA",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_ADLS_BRAZIL_SOURCE_CSV",
								"type": "DatasetReference",
								"parameters": {
									"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_container",
									"p_directory": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path",
									"p_file_name": "@string('')"
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "FILTER_CSV_FILES",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "GET_METADATA_SOURCE_FILES",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('GET_METADATA_SOURCE_FILES').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@equals(item().type, 'File')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "FEACH_CSV_FILES",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "FILTER_CSV_FILES",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('FILTER_CSV_FILES').output.Value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "LKUP_CHECK_FILE_TRACKING",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "GET_METADATA_CURRENT_FILE",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'EXEC dbo.vb_check_file_tracking ',\n    '@job_id = ', string(pipeline().parameters.p_job_id),\n    ', @source_file_name = ''', item().name, '''',\n    ', @source_file_path = ''',\n    activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path, '''',\n    ', @file_size_bytes = ',\n    string(activity('GET_METADATA_CURRENT_FILE').output.size),\n    ', @last_modified_time = ''',\n    string(activity('GET_METADATA_CURRENT_FILE').output.lastModified), ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_AZSQL_BLOOMBERG",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "GET_METADATA_CURRENT_FILE",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "DS_ADLS_BRAZIL_SOURCE_CSV",
											"type": "DatasetReference",
											"parameters": {
												"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_container",
												"p_directory": {
													"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path",
													"type": "Expression"
												},
												"p_file_name": "@item().name"
											}
										},
										"fieldList": [
											"size",
											"lastModified"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "DelimitedTextReadSettings"
										}
									}
								},
								{
									"name": "IF_FILE_NOT_PROCESSED",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "LKUP_CHECK_FILE_TRACKING",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@equals(\n    activity('LKUP_CHECK_FILE_TRACKING').output.firstRow.process_file,\n    true\n)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "SP_START_LOG",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[vb_start_log_entry]",
													"storedProcedureParameters": {
														"job_id": {
															"value": {
																"value": "@pipeline().parameters.p_job_id",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"pipeline_id": {
															"value": {
																"value": "@pipeline().parameters.p_master_pipeline_id",
																"type": "Expression"
															},
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().parameters.p_master_run_id",
																"type": "Expression"
															},
															"type": "String"
														},
														"source_file": {
															"value": {
																"value": "@item().name",
																"type": "Expression"
															},
															"type": "String"
														},
														"target_path": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_AZSQL_BLOOMBERG",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "COPY_CSV_TO_LANDING",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "SP_START_FILE_TRACKING",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "AzureBlobFSReadSettings",
															"recursive": false,
															"wildcardFolderPath": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path",
																"type": "Expression"
															},
															"wildcardFileName": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_pattern",
																"type": "Expression"
															},
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings",
															"copyBehavior": "PreserveHierarchy"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_ADLS_BRAZIL_SOURCE_CSV",
														"type": "DatasetReference",
														"parameters": {
															"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_container",
															"p_directory": "@string('')",
															"p_file_name": "@string('')"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_BRAZIL_LANDING_PARQUET",
														"type": "DatasetReference",
														"parameters": {
															"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_container",
															"p_directory": "@concat(     activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path,     '/',     formatDateTime(         convertFromUtc(utcnow(),'India Standard Time'),         'yyyy/MM/dd'     ) )",
															"p_file_name": "@concat(     replace(         activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_name,         '.csv',         ''     ),     '_',     formatDateTime(         convertFromUtc(utcnow(),'India Standard Time'),         'yyyyMMdd_HHmmss'     ),     '.parquet' )"
														}
													}
												]
											},
											{
												"name": "SP_END_LOG_SUCCESS",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "COPY_CSV_TO_LANDING",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[vb_end_log_entry]",
													"storedProcedureParameters": {
														"error_dtls": {
															"value": {
																"value": "@string('')",
																"type": "Expression"
															},
															"type": "String"
														},
														"job_id": {
															"value": {
																"value": "@pipeline().parameters.p_job_id",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"job_status": {
															"value": "SUCCESS",
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().parameters.p_master_run_id",
																"type": "Expression"
															},
															"type": "String"
														},
														"records_read": {
															"value": {
																"value": "@activity('COPY_CSV_TO_LANDING').output.rowsRead",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"records_written": {
															"value": {
																"value": "@activity('COPY_CSV_TO_LANDING').output.rowsCopied",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"source_file": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_name",
																"type": "Expression"
															},
															"type": "String"
														},
														"target_path": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_AZSQL_BLOOMBERG",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "SP_END_LOG_FAILED",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "COPY_CSV_TO_LANDING",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[vb_end_log_entry]",
													"storedProcedureParameters": {
														"error_dtls": {
															"value": {
																"value": "@string(activity('COPY_CSV_TO_LANDING').error.message)",
																"type": "Expression"
															},
															"type": "String"
														},
														"job_id": {
															"value": {
																"value": "@pipeline().parameters.p_job_id",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"job_status": {
															"value": "FAILED",
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().parameters.p_master_run_id",
																"type": "Expression"
															},
															"type": "String"
														},
														"records_read": {
															"value": null,
															"type": "Int64"
														},
														"records_written": {
															"value": null,
															"type": "Int64"
														},
														"source_file": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_name",
																"type": "Expression"
															},
															"type": "String"
														},
														"target_path": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_AZSQL_BLOOMBERG",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "SP_START_FILE_TRACKING",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "SP_START_LOG",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[vb_start_file_tracking]",
													"storedProcedureParameters": {
														"file_size_bytes": {
															"value": {
																"value": "@activity('GET_METADATA_CURRENT_FILE').output.size",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"job_id": {
															"value": {
																"value": "@pipeline().parameters.p_job_id",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"last_modified_time": {
															"value": {
																"value": "@activity('GET_METADATA_CURRENT_FILE').output.lastModified",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"type": "String"
														},
														"source_file_name": {
															"value": {
																"value": "@item().name",
																"type": "Expression"
															},
															"type": "String"
														},
														"source_file_path": {
															"value": {
																"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_AZSQL_BLOOMBERG",
													"type": "LinkedServiceReference"
												}
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_job_id": {
						"type": "int"
					},
					"p_master_pipeline_id": {
						"type": "string"
					},
					"p_master_run_id": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AZSQL_BLOOMBERG')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_BRAZIL_SOURCE_CSV')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AZSQL_BLOOMBERG')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_BRAZIL_LANDING_PARQUET')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_MASTER_INGESTION')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
