{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfbloombergdata"
		},
		"LS_ADLS_BRAZIL_CURATED_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_CURATED'"
		},
		"LS_ADLS_BRAZIL_LANDING_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_LANDING'"
		},
		"LS_ADLS_BRAZIL_SOURCE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_BRAZIL_SOURCE'"
		},
		"LS_AZSQL_BLOOMBERG_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZSQL_BLOOMBERG'"
		},
		"LS_ADLS_BRAZIL_CURATED_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloombergcurated.dfs.core.windows.net/"
		},
		"LS_ADLS_BRAZIL_LANDING_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbloomberglanding.dfs.core.windows.net/"
