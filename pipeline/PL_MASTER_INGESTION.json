{
	"name": "PL_MASTER_INGESTION",
	"properties": {
		"activities": [
			{
				"name": "SET_VAR_TRIGGER",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Trigger_variable",
					"value": {
						"value": "@if(\n    equals(pipeline().parameters.Trigger, null),\n    pipeline().TriggerName,\n    toUpper(pipeline().parameters.Trigger)\n)\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "LKUP_ALL_JOBS",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SET_VAR_TRIGGER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'EXEC dbo.vb_get_job_config @source_type = ''',\n    toUpper(replace(variables('Trigger_variable'), 'TR_', '')),\n    ''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZSQL_BLOOMBERG",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "EXEC_PL_PROCESS_ALL_JOBS",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "LKUP_ALL_JOBS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_PROCESS_ALL_JOBS",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_job_list": {
							"value": "@activity('LKUP_ALL_JOBS').output.value",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"p_run_mode": {
				"type": "string",
				"defaultValue": "SINGLE"
			},
			"p_job_id": {
				"type": "int",
				"defaultValue": 0
			},
			"Trigger": {
				"type": "string"
			}
		},
		"variables": {
			"Trigger_variable": {
				"type": "String"
			}
		},
		"annotations": []
	}
}