{
	"name": "PL_MASTER_INGESTION",
	"properties": {
		"activities": [
			{
				"name": "IF_CHECK_RUN_MODE",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(\n    toUpper(pipeline().parameters.p_run_mode),\n    'SINGLE'\n)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "LKUP_SINGLE_JOB",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "@concat(\n    'EXEC dbo.vb_get_job_dtls @job_id = ',\n    string(pipeline().parameters.p_job_id)\n)",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_AZSQL_BLOOMBERG",
									"type": "DatasetReference"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_run_mode": {
				"type": "string",
				"defaultValue": "SINGLE"
			},
			"p_job_id": {
				"type": "int",
				"defaultValue": 0
			}
		},
		"annotations": []
	}
}