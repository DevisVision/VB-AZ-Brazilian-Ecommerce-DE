{
	"name": "PL_INGEST_CSV",
	"properties": {
		"activities": [
			{
				"name": "LKUP_CSV_JOB_METADATA",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'EXEC dbo.vb_get_job_dtls @job_id = ',\n    string(pipeline().parameters.p_job_id)\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZSQL_BLOOMBERG",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "SP_START_LOG",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "LKUP_CSV_JOB_METADATA",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_start_log_entry]",
					"storedProcedureParameters": {
						"job_id": {
							"value": {
								"value": "@pipeline().parameters.p_job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"pipeline_id": {
							"value": {
								"value": "@pipeline().parameters.p_master_pipeline_id",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().parameters.p_master_run_id",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_name",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_BLOOMBERG",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "COPY_CSV_TO_LANDING",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SP_START_LOG",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"wildcardFolderPath": {
								"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_path",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_pattern",
								"type": "Expression"
							},
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_BRAZIL_SOURCE_CSV",
						"type": "DatasetReference",
						"parameters": {
							"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.source_container",
							"p_directory": "@string('')",
							"p_file_name": "@string('')"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_BRAZIL_LANDING_PARQUET",
						"type": "DatasetReference",
						"parameters": {
							"p_file_system": "@activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_container",
							"p_directory": "@concat(     activity('LKUP_CSV_JOB_METADATA').output.firstRow.target_path,     '/',     formatDateTime(         convertFromUtc(utcnow(),'India Standard Time'),         'yyyy/MM/dd'     ) )",
							"p_file_name": "@concat(     replace(         activity('LKUP_CSV_JOB_METADATA').output.firstRow.file_name,         '.csv',         ''     ),     '_',     formatDateTime(         convertFromUtc(utcnow(),'India Standard Time'),         'yyyyMMdd_HHmmss'     ),     '.parquet' )"
						}
					}
				]
			}
		],
		"parameters": {
			"p_job_id": {
				"type": "int"
			},
			"p_master_pipeline_id": {
				"type": "string"
			},
			"p_master_run_id": {
				"type": "string"
			}
		},
		"annotations": []
	}
}